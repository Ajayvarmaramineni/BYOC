{
  "name": "@byoc/google-drive",
  "version": "0.3.0",
  "description": "Google Drive storage provider adapter for BYOC (Bring Your Own Cloud)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@byoc/core": "^0.3.0",
    "@types/node": ">=26"
  },
  "keywords": [
    "byoc",
    "google-drive",
    "cloud-storage",
    "adapter",
    "oauth2",
    "pkce"
  ],
  "author": "Ajay Ramineni",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ajayvarmaramineni/BYOC.git",
    "directory": "packages/google-drive"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Ajayvarmaramineni/BYOC/tree/main/packages/google-drive#readme",
  "bugs": {
    "url": "https://github.com/Ajayvarmaramineni/BYOC/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
